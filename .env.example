# Copy to .env and fill in values. Never commit .env.

# Hugo site variables (non-sensitive)
HUGO_PARAMS_FIREBASE_AUTH_DOMAIN=
HUGO_PARAMS_FIREBASE_PROJECT_ID=
HUGO_PARAMS_FIREBASE_STORAGE_BUCKET=
# V2: cloud-predict-core on Proxmox (behind Cloudflare Tunnel)
# Local dev: http://localhost:8081
HUGO_PARAMS_BACKENDURL=http://localhost:8081
HUGO_PARAMS_ALLOWED_EMAILS=

# Hugo secrets (sensitive — keep out of vars, use GitHub Secrets)
HUGO_PARAMS_FIREBASE_API_KEY=
HUGO_PARAMS_FIREBASE_APP_ID=
HUGO_PARAMS_FIREBASE_MESSAGING_SENDER_ID=
